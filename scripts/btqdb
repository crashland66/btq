#!/usr/bin/env python3
"""btqdb - read BTQ CouchDB state and author validated queue jobs."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parent.parent
PROJECT_ROOT = REPO_ROOT / "project"
sys.path.insert(0, str(PROJECT_ROOT))

from event_pipeline.btq_client import (  # type: ignore  # noqa: E402
    BTQClientError,
    build_queue_doc,
    diagnose_job,
    enqueue,
    find,
    get_doc,
    job_schema,
    job_types,
)
from event_pipeline.couchdb_queue_reader import (  # type: ignore  # noqa: E402
    CouchDBQueueReaderError,
    list_queue_jobs,
    queue_state,
    sort_docs,
)


def print_json(value: Any) -> None:
    print(json.dumps(value, indent=2, sort_keys=True))


def read_job(path: Path | None) -> dict[str, Any]:
    raw = path.read_text(encoding="utf-8") if path is not None else sys.stdin.read()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise BTQClientError("invalid_json", f"input is not valid JSON: {exc}") from exc
    if not isinstance(data, dict):
        raise BTQClientError("invalid_job", "input JSON must be an object")
    return data


def format_queue_table(docs: list[dict[str, Any]]) -> str:
    if not docs:
        return "(no jobs match)"
    rows = []
    for doc in sort_docs(docs):
        doc_id = str(doc.get("_id") or "?")
        slug = doc_id.split("__", 1)[1] if "__" in doc_id else doc_id
        rows.append((str(doc.get("btq_state") or "?"), str(doc.get("job_type") or "?"), slug[:50], doc_id))
    width_state = max(len(row[0]) for row in rows)
    width_type = max(len(row[1]) for row in rows)
    width_slug = max(len(row[2]) for row in rows)
    lines = [f"{'STATE'.ljust(width_state)}  {'TYPE'.ljust(width_type)}  {'SLUG'.ljust(width_slug)}  ID"]
    lines.append("-" * (width_state + width_type + width_slug + 12))
    for state, job_type, slug, doc_id in rows:
        lines.append(f"{state.ljust(width_state)}  {job_type.ljust(width_type)}  {slug.ljust(width_slug)}  {doc_id}")
    lines.append(f"\n{len(rows)} job(s)")
    return "\n".join(lines)


def confirm_write() -> bool:
    if not sys.stdin.isatty():
        return False
    answer = input("Write this pending job to btq_queue? Type yes to continue: ")
    return answer == "yes"


def add_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("job-types", help="List allowed job types and required payload fields.")

    schema_parser = sub.add_parser("schema", help="Show required payload fields for a job type.")
    schema_parser.add_argument("type")

    get_parser = sub.add_parser("get", help="Read one document by database alias/name and id.")
    get_parser.add_argument("db")
    get_parser.add_argument("id")

    find_parser = sub.add_parser("find", help="Run a CouchDB _find selector against a database alias/name.")
    find_parser.add_argument("db")
    find_parser.add_argument("selector_json")
    find_parser.add_argument("--fields", help="JSON array of field names.")
    find_parser.add_argument("--limit", type=int, default=50)

    queue_parser = sub.add_parser("queue", help="Read btq_queue state using the existing queue reader.")
    queue_parser.add_argument("--list", action="store_true", help="List matching queue docs instead of state counts.")
    queue_parser.add_argument("--state", help="Filter queue docs or state report to one btq_state.")
    queue_parser.add_argument("--limit", type=int)
    queue_parser.add_argument("--all", action="store_true", help="For --list, include all dates instead of today only.")
    queue_parser.add_argument("--date", help="For --list, filter to creation date YYYY-MM-DD.")
    queue_parser.add_argument("--since", help="For --list, filter to creation date >= YYYY-MM-DD.")
    queue_parser.add_argument("--format", choices=["table", "json"], default="table")

    enqueue_parser = sub.add_parser("enqueue", help="Validate and enqueue a pending queue job.")
    enqueue_parser.add_argument("--file", type=Path, help="Read job JSON from this path instead of stdin.")
    enqueue_parser.add_argument("--dry-run", action="store_true", help="Validate and print the queue doc without writing.")
    enqueue_parser.add_argument("--yes", action="store_true", help="Skip interactive confirmation before writing.")
    enqueue_parser.add_argument("--force", action="store_true", help="Write even when queue_spec validation fails.")
    enqueue_parser.add_argument("--created-by", default="greg")

    return parser


def handle_queue(args: argparse.Namespace) -> int:
    if args.list:
        today = dt.date.today().isoformat()
        date_filter = args.date
        since_filter = args.since
        all_dates = args.all
        if not all_dates and not date_filter and not since_filter:
            date_filter = today
        docs = list_queue_jobs(
            date=date_filter,
            since=since_filter,
            state=args.state,
            all_dates=all_dates,
            limit=args.limit,
        )
        if args.format == "json":
            print_json(docs)
        else:
            print(format_queue_table(docs))
        return 0

    states = (args.state,) if args.state else ("failed", "pending", "processing", "claimed")
    print_json(queue_state(states=states))
    return 0


def handle_enqueue(args: argparse.Namespace) -> int:
    job = read_job(args.file)
    reasons = diagnose_job(job)
    if reasons and not args.force:
        print_json({"ok": False, "error": {"code": "invalid_job", "reasons": reasons}})
        return 2
    doc = build_queue_doc(job, created_by=args.created_by)
    print_json({"ok": not reasons, "force": bool(args.force and reasons), "validation_errors": reasons, "doc": doc})

    if args.dry_run:
        return 0
    if not args.yes and not confirm_write():
        print("btqdb: enqueue cancelled", file=sys.stderr)
        return 1

    result = enqueue(job, created_by=args.created_by, dry_run=False, force=args.force)
    print_json({"ok": True, "job_id": doc["_id"], "couchdb": result})
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = add_parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "job-types":
            print_json(job_types())
            return 0
        if args.command == "schema":
            print_json(job_schema(args.type))
            return 0
        if args.command == "get":
            print_json(get_doc(args.db, args.id))
            return 0
        if args.command == "find":
            selector = json.loads(args.selector_json)
            if not isinstance(selector, dict):
                raise BTQClientError("invalid_selector", "selector JSON must be an object")
            fields = json.loads(args.fields) if args.fields else None
            if fields is not None and not isinstance(fields, list):
                raise BTQClientError("invalid_selector", "--fields must be a JSON array")
            print_json(find(args.db, selector, fields=fields, limit=args.limit))
            return 0
        if args.command == "queue":
            return handle_queue(args)
        if args.command == "enqueue":
            return handle_enqueue(args)
    except json.JSONDecodeError as exc:
        print(f"btqdb: invalid JSON: {exc}", file=sys.stderr)
        return 2
    except BTQClientError as exc:
        print(f"btqdb: {exc.message}", file=sys.stderr)
        return 2 if exc.code.startswith("invalid") or exc.code == "unknown_job_type" else 1
    except CouchDBQueueReaderError as exc:
        print(f"btqdb: {exc.message}", file=sys.stderr)
        return 1
    parser.error(f"unknown command: {args.command}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

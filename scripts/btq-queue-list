#!/usr/bin/env python3
"""btq-queue-list — list queue jobs from CouchDB `btq_queue`.

Replaces directory globs over `BTpipeline/outbox/` and `processed/` /
`failed/` for AC-side skills (logsession, closeday, morning). After the
2026-05-22 iCloud-outbox removal and CouchDB cutover, queue state lives
in CouchDB; this is the AC view of it.

Usage:
  btq-queue-list                            # today's jobs, any state
  btq-queue-list --date 2026-05-27          # all jobs created that day
  btq-queue-list --state pending            # currently undrained
  btq-queue-list --state failed             # currently failed (await fix)
  btq-queue-list --since 2026-05-26         # everything authored on/after
  btq-queue-list --format ids               # job_ids only (one per line)
  btq-queue-list --format json              # full docs as JSON array
  btq-queue-list --format table             # human-readable summary (default)

Reads connection info from ~/.config/btq/config.json (same as btq-enqueue).
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PROJECT_ROOT = REPO_ROOT / "project"
sys.path.insert(0, str(PROJECT_ROOT))

from event_pipeline.couchdb_queue_reader import (  # type: ignore  # noqa: E402
    CouchDBQueueReaderError,
    DEFAULT_CONFIG_PATH,
    list_queue_jobs,
    load_reader_config,
    sort_docs,
)

def load_config(path: Path) -> dict:
    cfg = load_reader_config(path)
    return {
        "couchdb_url": cfg.couchdb.base_url,
        "couchdb_user": cfg.couchdb.username,
        "couchdb_password": cfg.couchdb.password,
        "queue_database": cfg.queue_database,
    }


def doc_date(doc: dict) -> str:
    # Prefer created_at (ISO-8601), fall back to leading ISO timestamp in _id.
    created = doc.get("created_at") or ""
    if created[:10].count("-") == 2:
        return created[:10]
    doc_id = doc.get("_id", "")
    if len(doc_id) >= 10 and doc_id[4] == "-" and doc_id[7] == "-":
        return doc_id[:10]
    return ""


def filter_docs(docs: list[dict], *, date: str | None, since: str | None, state: str | None) -> list[dict]:
    out = []
    for d in docs:
        d_date = doc_date(d)
        if date and d_date != date:
            continue
        if since and d_date and d_date < since:
            continue
        if state and d.get("btq_state") != state:
            continue
        out.append(d)
    return out


def format_table(docs: list[dict]) -> str:
    if not docs:
        return "(no jobs match)"
    rows = []
    for d in sorted(docs, key=lambda x: x.get("_id", "")):
        state = d.get("btq_state", "?")
        jt = d.get("job_type", "?")
        jid = d.get("_id", "?")
        slug = jid.split("__", 1)[1] if "__" in jid else jid
        slug = slug[:50]
        rows.append((state, jt, slug, jid))
    width_state = max(len(r[0]) for r in rows)
    width_jt = max(len(r[1]) for r in rows)
    width_slug = max(len(r[2]) for r in rows)
    lines = [f"{'STATE'.ljust(width_state)}  {'TYPE'.ljust(width_jt)}  {'SLUG'.ljust(width_slug)}  ID"]
    lines.append("-" * (width_state + width_jt + width_slug + 12))
    for state, jt, slug, jid in rows:
        lines.append(f"{state.ljust(width_state)}  {jt.ljust(width_jt)}  {slug.ljust(width_slug)}  {jid}")
    lines.append(f"\n{len(rows)} job(s)")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    today = dt.date.today().isoformat()
    parser.add_argument("--date", help="Filter to a single creation date (YYYY-MM-DD).")
    parser.add_argument("--since", help="Filter to creation date >= this (YYYY-MM-DD).")
    parser.add_argument("--state", help="Filter to a btq_state value (pending|processing|complete|failed|claimed).")
    parser.add_argument("--format", choices=["table", "ids", "json"], default="table")
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG_PATH)
    parser.add_argument("--all", action="store_true", help="No date filter; list every job in btq_queue.")
    args = parser.parse_args(argv)

    if args.all:
        date_filter = None
        since_filter = None
    elif args.date or args.since:
        date_filter = args.date
        since_filter = args.since
    else:
        date_filter = today
        since_filter = None

    try:
        config = load_reader_config(args.config)
        docs = list_queue_jobs(
            date=date_filter,
            since=since_filter,
            state=args.state,
            all_dates=args.all,
            config=config,
        )
    except CouchDBQueueReaderError as exc:
        if exc.code == "config_error" and args.config == DEFAULT_CONFIG_PATH and not args.config.exists():
            print(f"btq-queue-list: config not found at {args.config}", file=sys.stderr)
        elif exc.code == "config_error":
            print(f"btq-queue-list: {exc.message}", file=sys.stderr)
        else:
            print(f"btq-queue-list: {exc.message}", file=sys.stderr)
        return 1

    if args.format == "ids":
        for d in sort_docs(docs):
            print(d.get("_id", ""))
    elif args.format == "json":
        print(json.dumps(docs, indent=2, sort_keys=True))
    else:
        print(format_table(docs))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

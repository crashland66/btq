#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_ROOT="${REPO_ROOT}/project"
PYTHON_BIN="${PROJECT_ROOT}/.venv/bin/python"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="python3"
fi

cd "${REPO_ROOT}"

"${PYTHON_BIN}" -m pymarkdown \
  --config "${REPO_ROOT}/.pymarkdown.json" \
  scan \
  --recurse \
  project/field_capture

"${PYTHON_BIN}" -m pymarkdown \
  --config "${REPO_ROOT}/.pymarkdown.json" \
  --disable-rules md013,md024 \
  scan \
  --recurse \
  --exclude "project/docs/examples/vault/**" \
  project/docs

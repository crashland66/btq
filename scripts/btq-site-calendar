#!/usr/bin/env python3
"""Show upcoming operational-calendar events for an operator's active sites."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any, Mapping

REPO_ROOT = Path(__file__).resolve().parent.parent
PROJECT_ROOT = REPO_ROOT / "project"
sys.path.insert(0, str(PROJECT_ROOT))

from event_pipeline import couchdb_config  # type: ignore  # noqa: E402
from event_pipeline.btq_client import BTQClientError  # type: ignore  # noqa: E402
from event_pipeline.couchdb_queue_reader import (  # type: ignore  # noqa: E402
    CouchDBQueueReaderError,
)
from event_pipeline.site_operational_calendar import (  # type: ignore  # noqa: E402
    SiteOperationalCalendarError,
    site_calendar_report,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--operator", required=True, help="Operator name or canonical ID.")
    parser.add_argument("--from", dest="from_date", required=True, help="Inclusive YYYY-MM-DD start.")
    parser.add_argument("--through", dest="through_date", required=True, help="Inclusive YYYY-MM-DD end.")
    parser.add_argument("--format", choices=("json", "text"), default="json")
    return parser


def format_text(report: Mapping[str, Any]) -> str:
    events = report.get("events")
    diagnostics = report.get("diagnostics")
    event_rows = events if isinstance(events, list) else []
    diagnostic_rows = diagnostics if isinstance(diagnostics, list) else []
    lines = [
        f"Operator: {report.get('operator') or ''}",
        f"Window: {report.get('from_date') or ''} through {report.get('through_date') or ''}",
        f"Events: {len(event_rows)}",
    ]
    for event in event_rows:
        if not isinstance(event, Mapping):
            continue
        date_text = str(event.get("start_date") or "")
        if event.get("end_date") != event.get("start_date"):
            date_text += f"–{event.get('end_date') or ''}"
        sites = event.get("affected_sites")
        site_text = ", ".join(
            f"{site.get('site_name') or site.get('site_id')} ({site.get('site_id')})"
            for site in sites if isinstance(site, Mapping)
        ) if isinstance(sites, list) else ""
        lines.append(
            f"- {date_text} | {event.get('label') or ''} | "
            f"{event.get('bt_service_impact') or ''} | {site_text}"
        )
    lines.append(f"Diagnostics: {len(diagnostic_rows)}")
    for diagnostic in diagnostic_rows:
        if not isinstance(diagnostic, Mapping):
            continue
        calendar = diagnostic.get("calendar_id") or "(calendar)"
        lines.append(
            f"- {diagnostic.get('site_name') or diagnostic.get('site_id')} "
            f"({diagnostic.get('site_id')}) | {calendar} | "
            f"{diagnostic.get('kind') or ''}: {diagnostic.get('message') or ''}"
        )
    return "\n".join(lines)


def main(
    argv: list[str] | None = None,
    *,
    report_builder: Any | None = None,
    snapshot: Mapping[str, Any] | None = None,
    docs: Any = None,
    config: Any = None,
) -> int:
    parser = build_parser()
    try:
        try:
            args = parser.parse_args(argv)
        except SystemExit as exc:
            return exc.code if isinstance(exc.code, int) else 2
        builder = report_builder or site_calendar_report
        builder_kwargs = {}
        if snapshot is not None:
            builder_kwargs["snapshot"] = snapshot
        if docs is not None:
            builder_kwargs["docs"] = docs
        if config is not None:
            builder_kwargs["config"] = config
        report = builder(
            args.operator,
            args.from_date,
            args.through_date,
            **builder_kwargs,
        )
    except SiteOperationalCalendarError as exc:
        print(f"btq-site-calendar: {exc}", file=sys.stderr)
        return 2
    except BTQClientError as exc:
        print(f"btq-site-calendar: {exc.message}", file=sys.stderr)
        return 2 if exc.code.startswith("invalid") else 1
    except CouchDBQueueReaderError as exc:
        print(f"btq-site-calendar: {exc.message}", file=sys.stderr)
        return 1
    except couchdb_config.CouchDBConfigError as exc:
        print(f"btq-site-calendar: {exc}", file=sys.stderr)
        return 1

    if args.format == "text":
        print(format_text(report))
    else:
        print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

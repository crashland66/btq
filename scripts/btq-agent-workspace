#!/usr/bin/env python3
"""btq-agent-workspace - manage local non-canonical agent workspaces."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PROJECT_ROOT = REPO_ROOT / "project"
sys.path.insert(0, str(PROJECT_ROOT))

from event_pipeline import agent_workspace  # type: ignore  # noqa: E402


def print_json(value: object) -> None:
    print(json.dumps(value, indent=2, sort_keys=True))


def add_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--operator", required=True, help="Operator name or id.")
    common.add_argument("--project", required=True, help="Project name or id.")
    common.add_argument("--base", type=Path, help="Override the runtime base directory. Intended for tests.")

    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("init", parents=[common], help="Initialize a local agent workspace and print its path.")

    path_parser = sub.add_parser("path", parents=[common], help="Print the resolved local agent workspace path.")
    path_parser.add_argument("--format", choices=["json", "text"], default="text")

    run_parser = sub.add_parser("new-run", parents=[common], help="Create a dated run bundle and print its path.")
    run_parser.add_argument("--slug", required=True, help="Human-readable slug for the run bundle.")

    return parser


def _base(args: argparse.Namespace) -> Path | None:
    return args.base.expanduser() if args.base is not None else None


def handle_init(args: argparse.Namespace) -> int:
    path = agent_workspace.init_workspace(args.operator, args.project, base=_base(args))
    print(path)
    return 0


def handle_path(args: argparse.Namespace) -> int:
    path = agent_workspace.workspace_path(args.operator, args.project, base=_base(args))
    if args.format == "json":
        print_json({"workspace": str(path)})
    else:
        print(path)
    return 0


def handle_new_run(args: argparse.Namespace) -> int:
    path = agent_workspace.new_run(args.operator, args.project, args.slug, base=_base(args))
    print(path)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = add_parser()
    try:
        try:
            args = parser.parse_args(argv)
        except SystemExit as exc:
            return exc.code if isinstance(exc.code, int) else 2
        if args.command == "init":
            return handle_init(args)
        if args.command == "path":
            return handle_path(args)
        if args.command == "new-run":
            return handle_new_run(args)
    except agent_workspace.AgentWorkspaceError as exc:
        print(f"btq-agent-workspace: {exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"btq-agent-workspace: {exc}", file=sys.stderr)
        return 1
    parser.error(f"unknown command: {args.command}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "usage: ./scripts/btq-migrate-prospects-to-sites-db"
  exit 0
fi

PLIST="$HOME/Library/LaunchAgents/com.btq.couchdb-field-capture-watcher.plist"
PLIST_KEY() { /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$1" "$PLIST" 2>/dev/null || true; }

export BTQ_COUCHDB_USER="${BTQ_COUCHDB_USER:-$(PLIST_KEY BTQ_COUCHDB_USER)}"
export BTQ_COUCHDB_PASSWORD="${BTQ_COUCHDB_PASSWORD:-$(PLIST_KEY BTQ_COUCHDB_PASSWORD)}"
export BTQ_COUCHDB_URL="${BTQ_COUCHDB_URL:-$(PLIST_KEY BTQ_COUCHDB_URL)}"
export BTQ_COUCHDB_URL="${BTQ_COUCHDB_URL:-http://127.0.0.1:5984}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_ROOT="${REPO_ROOT}/project"
PYTHON_BIN="${PROJECT_ROOT}/.venv/bin/python"

cd "${PROJECT_ROOT}"

exec "${PYTHON_BIN}" - <<'PYEOF'
from __future__ import annotations

import json
import sys
from urllib import error, parse, request

from event_pipeline import couchdb_config


def req(config, method, database, path, data=None):
    url = f"{config.base_url}/{parse.quote(database, safe='')}/{path}"
    body = json.dumps(data, sort_keys=True).encode("utf-8") if data is not None else None
    headers = {"Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    headers.update(config.auth_header())
    http_req = request.Request(url, data=body, headers=headers, method=method)
    with request.urlopen(http_req, timeout=config.timeout) as response:
        raw = response.read()
    return json.loads(raw.decode("utf-8")) if raw else {}


def put_doc(config, database, doc):
    doc_id = parse.quote(str(doc["_id"]), safe="")
    return req(config, "PUT", database, doc_id, doc)


def delete_doc(config, database, doc_id, rev):
    path = f"{parse.quote(str(doc_id), safe='')}?rev={parse.quote(str(rev), safe='')}"
    return req(config, "DELETE", database, path)


def find_prospects(config, database):
    payload = {"selector": {"type": "prospect"}, "limit": 10000}
    return req(config, "POST", database, "_find", payload).get("docs", [])


def main():
    config = couchdb_config.from_env()
    source_database = couchdb_config.vault_database()
    target_database = couchdb_config.sites_database()
    migrated = skipped = errors = 0
    try:
        docs = find_prospects(config, source_database)
    except Exception as exc:
        print(f"btq_vault: ERROR querying prospects: {exc}", file=sys.stderr)
        print("migrated=0 skipped=0 errors=1")
        return 2

    for doc in docs:
        if not isinstance(doc, dict):
            skipped += 1
            continue
        doc_id = doc.get("_id")
        rev = doc.get("_rev")
        if not doc_id or not rev:
            skipped += 1
            continue
        target_doc = dict(doc)
        target_doc.pop("_rev", None)
        try:
            put_doc(config, target_database, target_doc)
            delete_doc(config, source_database, doc_id, rev)
            migrated += 1
        except error.HTTPError as exc:
            if exc.code == 409:
                skipped += 1
                continue
            print(f"{doc_id}: ERROR HTTP {exc.code}", file=sys.stderr)
            errors += 1
        except Exception as exc:
            print(f"{doc_id}: ERROR {exc}", file=sys.stderr)
            errors += 1

    print(f"migrated={migrated} skipped={skipped} errors={errors}")
    return 2 if errors else 0


raise SystemExit(main())
PYEOF

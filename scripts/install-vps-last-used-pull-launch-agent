#!/bin/zsh
set -euo pipefail

# Install the launchd cron that pulls VPS field-capture last_used_at into the
# Pro's token DB every 5 minutes. Counterpart to the auto-sync hook in
# tokens.py: that one keeps mutations flowing Pro → VPS; this one closes
# the read-only drift in the opposite direction (the VPS field-capture
# service is the only writer of last_used_at, and the Pro dashboard
# otherwise never sees those updates).
#
# Restart-after-code-pull is not needed for this job; it's a periodic
# cron, not a long-running daemon, so the next firing picks up new
# script content automatically.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PULL_SCRIPT="${REPO_ROOT}/scripts/btq-pull-vps-last-used"

if [[ ! -x "${PULL_SCRIPT}" ]]; then
  echo "puller not found or not executable: ${PULL_SCRIPT}" >&2
  exit 1
fi

LAUNCH_AGENTS_DIR="${HOME}/Library/LaunchAgents"
PLIST_PATH="${LAUNCH_AGENTS_DIR}/com.btq.vps-last-used-pull.plist"
LOG_DIR="${HOME}/btq_runtime/logs"
STDOUT_LOG="${LOG_DIR}/vps-last-used-pull.out.log"
STDERR_LOG="${LOG_DIR}/vps-last-used-pull.err.log"

INTERVAL="${VPS_LAST_USED_PULL_INTERVAL_SECONDS:-300}"

mkdir -p "${LAUNCH_AGENTS_DIR}"
mkdir -p "${LOG_DIR}"

cat > "${PLIST_PATH}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.btq.vps-last-used-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PULL_SCRIPT}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>${REPO_ROOT}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>${INTERVAL}</integer>
  <key>StandardOutPath</key>
  <string>${STDOUT_LOG}</string>
  <key>StandardErrorPath</key>
  <string>${STDERR_LOG}</string>
</dict>
</plist>
EOF

launchctl bootout "gui/$(id -u)/com.btq.vps-last-used-pull" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "${PLIST_PATH}"

printf 'Installed and started %s\n' "${PLIST_PATH}"
printf '  Cadence: every %s seconds\n' "${INTERVAL}"
printf '  Logs: %s\n' "${STDOUT_LOG}"
printf '\nForce an immediate run: launchctl kickstart -k gui/$(id -u)/com.btq.vps-last-used-pull\n'

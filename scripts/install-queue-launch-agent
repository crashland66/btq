#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_ROOT="${REPO_ROOT}/project"
PYTHON_BIN="${PROJECT_ROOT}/.venv/bin/python"

config_value() {
  (cd "${PROJECT_ROOT}" && "${PYTHON_BIN}" -m config get "$1")
}

LAUNCH_AGENTS_DIR="${HOME}/Library/LaunchAgents"
PLIST_PATH="${LAUNCH_AGENTS_DIR}/com.btq.queue-watch.plist"
STDOUT_LOG="$(config_value queue_watch_launchd_stdout_log)"
STDERR_LOG="$(config_value queue_watch_launchd_stderr_log)"

mkdir -p "${LAUNCH_AGENTS_DIR}"
mkdir -p "$(dirname "${STDOUT_LOG}")"

cat > "${PLIST_PATH}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.btq.queue-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PYTHON_BIN}</string>
    <string>-m</string>
    <string>queue_processor.watch</string>
  </array>
  <key>WorkingDirectory</key>
  <string>${PROJECT_ROOT}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
$(for var in BTQ_COUCHDB_URL BTQ_COUCHDB_USER BTQ_COUCHDB_PASSWORD BTQ_OLLAMA_URL BTQ_WHISPER_URL BTQ_VAULT_PATH_PREFIXES; do
  val="${(P)var:-}"
  if [[ -n "${val}" ]]; then
    printf '    <key>%s</key>\n    <string>%s</string>\n' "${var}" "${val}"
  fi
done)  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${STDOUT_LOG}</string>
  <key>StandardErrorPath</key>
  <string>${STDERR_LOG}</string>
</dict>
</plist>
EOF

launchctl bootout "gui/$(id -u)/com.btq.queue-watch" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "${PLIST_PATH}"
launchctl kickstart -k "gui/$(id -u)/com.btq.queue-watch"

printf 'Installed and started %s\n' "${PLIST_PATH}"

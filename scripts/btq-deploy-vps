#!/usr/bin/env bash
# btq-deploy-vps — push current branch to VPS bare repo and run the production deploy.
#
# Flow: push to origin → SSH to VPS → fast-forward the source clone →
# run the existing scripts/deploy-field-capture-app-on-vps (which handles
# staging, backup, systemctl restart, and the public-URL smoke test).
#
# Prerequisite (one-time): clone the bare repo into a source working dir on the VPS:
#   ssh deploy@vps.example.com 'git clone ~/git/btq.git ~/btq-source'
#
# Usage:
#   btq-deploy-vps [git-ref]   # ref defaults to current branch

set -euo pipefail

REF="${1:-$(git symbolic-ref --short HEAD)}"
VPS="${BTQ_VPS_SSH_TARGET:-deploy@vps.example.com}"
VPS_SOURCE="~/btq-source"

printf '→ pushing %s to origin\n' "$REF"
git push origin "$REF"

printf '→ updating source clone on VPS and running deploy\n'
ssh "$VPS" bash <<EOF
set -e
cd ${VPS_SOURCE}
git fetch origin
git checkout '${REF}'
git merge --ff-only 'origin/${REF}'
./scripts/deploy-field-capture-app-on-vps
EOF

printf '\n✓ VPS deploy complete\n'

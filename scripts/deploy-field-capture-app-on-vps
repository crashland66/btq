#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOURCE_ROOT="${FIELD_CAPTURE_SOURCE_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"

APP_DIR="${FIELD_CAPTURE_APP_DIR:-/srv/btq/apps/field-capture}"
BACKUP_ROOT="${FIELD_CAPTURE_BACKUP_ROOT:-/srv/btq/backups/field-capture}"
SERVICE="${FIELD_CAPTURE_SERVICE:-btq-field-capture.service}"
SYSTEMCTL="${FIELD_CAPTURE_SYSTEMCTL:-/usr/bin/systemctl}"
SERVICE_USE_SUDO="${FIELD_CAPTURE_SERVICE_USE_SUDO:-1}"
PUBLIC_URL="${FIELD_CAPTURE_PUBLIC_URL:-https://photos.example.com}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
REMOTE_TMP="/tmp/btq-field-capture-release-${STAMP}"
USE_SUDO="${FIELD_CAPTURE_USE_SUDO:-1}"
SUDO=(sudo)
SERVICE_SUDO=(sudo -n)
BACKUP_CP_ARGS=(-a)
INSTALL_RSYNC_ARGS=(-a --delete)
PYTHON_CACHE_RSYNC_EXCLUDES=(
  --exclude '__pycache__/'
  --exclude '*.pyc'
  --exclude '.pytest_cache/'
  --exclude '.mypy_cache/'
  --exclude '.ruff_cache/'
)

if [[ "${USE_SUDO}" == "0" ]]; then
  SUDO=()
  BACKUP_CP_ARGS=(-a --no-preserve=ownership)
  INSTALL_RSYNC_ARGS+=(--no-owner --no-group --no-perms --omit-dir-times)
fi

INSTALL_RSYNC_ARGS+=("${PYTHON_CACHE_RSYNC_EXCLUDES[@]}")

if [[ "${SERVICE_USE_SUDO}" == "0" ]]; then
  SERVICE_SUDO=()
fi

fail() {
  echo "Deploy preflight failed: $*" >&2
  exit 1
}

service_command() {
  "${SERVICE_SUDO[@]}" "${SYSTEMCTL}" "$@" "${SERVICE}"
}

explain_service_sudo_failure() {
  cat >&2 <<EOF

Service management failed for ${SERVICE}.
If deploying as the deploy user, sudoers must allow these exact noninteractive commands:
  sudo -n ${SYSTEMCTL} restart ${SERVICE}
  sudo -n ${SYSTEMCTL} is-active ${SERVICE}
  sudo -n ${SYSTEMCTL} status ${SERVICE}
EOF
}

restart_service() {
  local output
  if ! output="$(service_command restart 2>&1)"; then
    echo "${output}" >&2
    explain_service_sudo_failure
    exit 1
  fi
}

verify_service_active() {
  local output
  if ! output="$(service_command is-active 2>&1)"; then
    echo "${output}" >&2
    explain_service_sudo_failure
    exit 1
  fi
  echo "${output}"
}

check_writable_directory() {
  local path="$1"
  local label="$2"
  local probe="${path}/.btq-deploy-write-test-${STAMP}-$$"

  [[ -d "${path}" ]] || fail "${label} does not exist: ${path}"
  [[ -w "${path}" ]] || fail "${label} is not writable by $(id -un): ${path}"
  if ! : >"${probe}" 2>/dev/null; then
    fail "${label} does not allow temp file creation by $(id -un): ${path}"
  fi
  rm -f "${probe}"
}

preflight_non_sudo_deploy() {
  local backup_parent
  local unwritable_dir
  local unwritable_file

  backup_parent="$(dirname "${BACKUP_ROOT}")"
  check_writable_directory "${APP_DIR}" "live app directory"
  check_writable_directory "${APP_DIR}/project/field_capture" "live field-capture static directory"
  if [[ -d "${BACKUP_ROOT}" ]]; then
    check_writable_directory "${BACKUP_ROOT}" "backup directory"
  else
    check_writable_directory "${backup_parent}" "backup parent directory"
  fi

  unwritable_dir="$(
    find "${APP_DIR}" \
      \( -name '__pycache__' -o -name '.pytest_cache' -o -name '.mypy_cache' -o -name '.ruff_cache' \) -prune \
      -o -type d ! -writable -print -quit
  )"
  if [[ -n "${unwritable_dir}" ]]; then
    fail "live app tree contains a directory that is not writable by $(id -un): ${unwritable_dir}"
  fi

  unwritable_file="$(
    find "${APP_DIR}" \
      \( -name '__pycache__' -o -name '.pytest_cache' -o -name '.mypy_cache' -o -name '.ruff_cache' \) -prune \
      -o -type f ! -name '*.pyc' ! -writable -print -quit
  )"
  if [[ -n "${unwritable_file}" ]]; then
    fail "live app tree contains a source file that is not writable by $(id -un): ${unwritable_file}"
  fi

  for runtime_dir in /srv/btq/runtime /srv/btq/runtime/uploads /srv/btq/runtime/queue /srv/btq/runtime/logs; do
    [[ -d "${runtime_dir}" ]] || fail "runtime directory is missing: ${runtime_dir}"
  done
}

if [[ ! -f "${SOURCE_ROOT}/project/field_capture/server.py" ]]; then
  echo "Source root does not look like the BTQ repo: ${SOURCE_ROOT}" >&2
  exit 1
fi

if [[ "$(cd "${SOURCE_ROOT}" && pwd)" == "$(cd "${APP_DIR}" 2>/dev/null && pwd 2>/dev/null || true)" ]]; then
  echo "Refusing to deploy from the live app directory into itself: ${APP_DIR}" >&2
  echo "Run this from a separate checkout or set FIELD_CAPTURE_SOURCE_ROOT to one." >&2
  exit 1
fi

echo "Deploying field-capture app on this VPS."
echo "Source: ${SOURCE_ROOT}"
echo "Target: ${APP_DIR}"
echo "Service: ${SERVICE}"
echo

if [[ "${USE_SUDO}" == "0" ]]; then
  echo "Running non-sudo deploy preflight..."
  preflight_non_sudo_deploy
fi

if [[ ! -x "${SYSTEMCTL}" ]]; then
  fail "systemctl executable not found or not executable: ${SYSTEMCTL}"
fi

echo "Staging release in ${REMOTE_TMP}..."
rm -rf "${REMOTE_TMP}"
mkdir -p "${REMOTE_TMP}"
rsync -a \
  --exclude '.git' \
  --exclude '.venv' \
  "${PYTHON_CACHE_RSYNC_EXCLUDES[@]}" \
  --exclude 'btq_runtime' \
  --exclude 'project/.runtime' \
  --exclude 'project/.runtime-dry' \
  "${SOURCE_ROOT}/README.md" \
  "${SOURCE_ROOT}/config.json" \
  "${SOURCE_ROOT}/pyproject.toml" \
  "${SOURCE_ROOT}/project" \
  "${REMOTE_TMP}/"

echo "Installing release."
"${SUDO[@]}" mkdir -p "${BACKUP_ROOT}"
"${SUDO[@]}" cp "${BACKUP_CP_ARGS[@]}" "${APP_DIR}" "${BACKUP_ROOT}/field-capture-${STAMP}"
"${SUDO[@]}" rsync "${INSTALL_RSYNC_ARGS[@]}" "${REMOTE_TMP}/" "${APP_DIR}/"
# Populate APP_DIR/dist/ from project/field_capture/public/. Caddy serves the
# SPA static assets (app.js, index.html, styles.css, assets/, manifest, etc.)
# from APP_DIR/dist/, not from the backend's try_serve_static fallback. The
# install rsync above does not produce dist/, and its --delete flag REMOVES
# any pre-existing dist/. Without this step a deploy silently breaks Caddy's
# static serving for the SPA. --delete here is correct: dist/ should be a
# clean mirror of the SPA public assets, never a stale leftover.
"${SUDO[@]}" mkdir -p "${APP_DIR}/dist"
"${SUDO[@]}" rsync -a --delete \
  "${APP_DIR}/project/field_capture/public/" "${APP_DIR}/dist/"
# Materialize the shared PWA offline assets into dist/. Prompt 177 moved db.js
# and sw.js out of field_capture/public/ into project/shared_pwa/ (single source).
# Caddy serves static from dist/, so the --delete rsync above (mirroring public/)
# no longer includes them — render/copy them here, or the PWA's IndexedDB queue
# (db.js) and background-sync service worker (sw.js) 404 in production.
"${SUDO[@]}" env PYTHONPATH="${APP_DIR}/project" python3 - "${APP_DIR}/dist" <<'PY'
import sys
from pathlib import Path
from shared_pwa.assets import shared_db_bytes, render_service_worker_bytes
dist = Path(sys.argv[1])
(dist / "db.js").write_bytes(shared_db_bytes())
(dist / "sw.js").write_bytes(render_service_worker_bytes("field_capture"))
print(f"materialized shared PWA assets into {dist}: db.js, sw.js")
PY
"${SUDO[@]}" cp "${APP_DIR}/project/field_capture/config.production.json" "${APP_DIR}/config.json"
if [[ "${USE_SUDO}" == "0" ]]; then
  echo "Runtime directories already verified for non-sudo deploy."
else
  "${SUDO[@]}" install -d -o btq-field -g btq-field -m 0750 /srv/btq/runtime
  "${SUDO[@]}" install -d -o btq-field -g btq-field -m 0750 /srv/btq/runtime/uploads /srv/btq/runtime/queue /srv/btq/runtime/logs
fi

echo "Restarting ${SERVICE}..."
restart_service
sleep 2

echo "Verifying local service..."
verify_service_active
# Note: the backend's BaseHTTPServer does not implement do_HEAD, so a
# `curl -fsSI` on /app.js or / would always 501 against this server.
# The semantic check is on the body via the GET below — that's what
# actually proves the new code is live.
LOCAL_APP_JS="$(curl -fsSL http://127.0.0.1:8080/app.js)"
if [[ "${LOCAL_APP_JS}" != *saveCapture* ]]; then
  echo "Local app.js does not contain saveCapture after deploy" >&2
  exit 1
fi
if [[ "${LOCAL_APP_JS}" == *downloadJob* ]]; then
  echo "Local app.js still contains downloadJob after deploy" >&2
  exit 1
fi

echo "Verifying public app..."
PUBLIC_APP_JS="$(curl -fsSL "${PUBLIC_URL}/app.js")"
if [[ "${PUBLIC_APP_JS}" != *saveCapture* ]]; then
  echo "Public app.js does not contain saveCapture after deploy" >&2
  exit 1
fi
if [[ "${PUBLIC_APP_JS}" == *downloadJob* ]]; then
  echo "Public app.js still contains downloadJob after deploy" >&2
  exit 1
fi
# The PWA offline assets are served by Caddy from dist/ and are materialized from
# project/shared_pwa/ (prompt 177). Verify they actually serve — a prior deploy
# silently 404'd them (moved out of public/, not materialized into dist/), which
# breaks window.fieldCaptureDb and the service worker.
PUBLIC_DB_JS="$(curl -fsSL "${PUBLIC_URL}/db.js")" || { echo "Public /db.js did not serve (200) after deploy" >&2; exit 1; }
if [[ "${PUBLIC_DB_JS}" != *field_capture_v1* ]]; then
  echo "Public /db.js served but lacks expected IndexedDB content after deploy" >&2
  exit 1
fi
PUBLIC_SW_JS="$(curl -fsSL "${PUBLIC_URL}/sw.js")" || { echo "Public /sw.js did not serve (200) after deploy" >&2; exit 1; }
if [[ "${PUBLIC_SW_JS}" != *recovered_orphaned_upload* ]]; then
  echo "Public /sw.js served but lacks orphan-recovery logic after deploy" >&2
  exit 1
fi

rm -rf "${REMOTE_TMP}"

echo
echo "Deploy complete."
echo "Backup: ${BACKUP_ROOT}/field-capture-${STAMP}"
echo "Target: ${APP_DIR}"
echo "Service: ${SERVICE}"
echo "Public URL: ${PUBLIC_URL}"

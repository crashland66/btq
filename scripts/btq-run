#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_ROOT="${REPO_ROOT}/project"
PYTHON_BIN="${PROJECT_ROOT}/.venv/bin/python"

config_value() {
  (cd "${PROJECT_ROOT}" && "${PYTHON_BIN}" -m config get "$1")
}

RUNTIME_ROOT="$(config_value project_runtime_root)"

cd "${PROJECT_ROOT}"

exec "${PYTHON_BIN}" -m queue_processor.main \
  --project-root "${PROJECT_ROOT}" \
  --runtime-root "${RUNTIME_ROOT}"

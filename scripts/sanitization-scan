#!/usr/bin/env python3
"""Pattern scan for public-repo sanitization.

Default mode scans staged additions plus the current branch name. CI mode scans
the pull-request or push diff, commit messages in that diff, and the CI branch
name. A commit-msg hook may pass --commit-msg-file to scan the proposed commit
message with this same logic.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parent.parent
ALLOWLIST_PATH = REPO_ROOT / "scripts" / "sanitization-allow.txt"
NULL_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"

OK_MARKER = "sanitization-ok"


@dataclass(frozen=True)
class ScannedLine:
    source: str
    line_number: int
    text: str


@dataclass(frozen=True)
class Finding:
    source: str
    line_number: int
    rule: str
    detail: str
    remediation: str
    text: str


@dataclass(frozen=True)
class Rule:
    name: str
    pattern: re.Pattern[str]
    detail: str
    remediation: str


RULES = [
    Rule(
        "secret-shaped fc token",
        re.compile(r"fc_[A-Za-z0-9_-]{18,}"),
        "field-capture token-shaped value",
        "Remove the token value. Use a runtime secret or a short placeholder.",
    ),
    Rule(
        "secret-shaped access key",
        re.compile(r"AKIA[0-9A-Z]{12,}"),
        "access-key-shaped value",
        "Remove the credential. Use configuration or a non-secret placeholder.",
    ),
    Rule(
        "private key header",
        re.compile(r"-----BEGIN [A-Z ]+PRIVATE KEY"),
        "private-key material",
        "Remove the key material and rotate it if it was real.",
    ),
    Rule(
        "quoted secret assignment",
        re.compile(
            r"(?i)\b(password|secret|token|api[_-]?key)\b\s*[:=]\s*"
            r"(['\"])([A-Za-z0-9_+/=-]{16,})\2"
        ),
        "secret-like key assigned to a quoted long literal",
        "Use an environment/config reference or a short non-secret placeholder.",
    ),
    Rule(
        "absolute user-home path",
        re.compile(r"/(?:Users|home)/([A-Za-z0-9._-]+)/"),
        "absolute user-home path",
        "Use a relative path, runtime configuration, or /Users/example/ for docs.",
    ),
    Rule(
        "tailnet hostname",
        re.compile(r"\b[a-z0-9]+(?:-[a-z0-9]+)+\.ts\.net\b", re.IGNORECASE),
        "tailnet hostname",
        "Use a public placeholder hostname or runtime configuration.",
    ),
    Rule(
        "gateway hostname",
        re.compile(r"\bbt-gateway-\d+\b", re.IGNORECASE),
        "internal gateway hostname",
        "Use a generic placeholder or runtime configuration.",
    ),
    Rule(
        "tailnet address",
        re.compile(r"\b100\.1[0-9]{2}\.\d{1,3}\.\d{1,3}\b"),
        "tailnet address",
        "Use a documentation-reserved address or runtime configuration.",
    ),
    Rule(
        "private network address",
        re.compile(
            r"\b(?:10\.\d{1,3}\.\d{1,3}\.\d{1,3}|"
            r"172\.(?:1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}|"
            r"192\.168\.\d{1,3}\.\d{1,3})(?::5984)?\b"
        ),
        "private network address",
        "Use localhost, a documentation-reserved address, or runtime configuration.",
    ),
]


def run_git(args: list[str], *, check: bool = True) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=REPO_ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if check and result.returncode != 0:
        print(f"sanitization-scan: git {' '.join(args)} failed", file=sys.stderr)
        print(result.stderr, file=sys.stderr, end="")
        raise SystemExit(2)
    return result.stdout


def load_allowlist() -> list[re.Pattern[str]]:
    if not ALLOWLIST_PATH.exists():
        return []
    patterns: list[re.Pattern[str]] = []
    for number, raw in enumerate(ALLOWLIST_PATH.read_text().splitlines(), start=1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        try:
            patterns.append(re.compile(stripped))
        except re.error as exc:
            print(
                f"sanitization-scan: invalid allowlist pattern "
                f"{ALLOWLIST_PATH}:{number}: {exc}",
                file=sys.stderr,
            )
            raise SystemExit(2)
    return patterns


def has_inline_ok(text: str) -> bool:
    if OK_MARKER not in text:
        return False
    hash_match = re.search(r"#\s*sanitization-ok:\s*\S+", text)
    slash_match = re.search(r"//\s*sanitization-ok(?:\b|:)", text)
    return bool(hash_match or slash_match)


def is_allowlisted(text: str, allowlist: list[re.Pattern[str]]) -> bool:
    return any(pattern.fullmatch(text) or pattern.search(text) for pattern in allowlist)


def path_match_is_allowed(match: re.Match[str]) -> bool:
    full = match.group(0)
    user = match.group(1)
    return full.startswith("/Users/example/") or user == "example"


def scan_lines(lines: list[ScannedLine], allowlist: list[re.Pattern[str]]) -> list[Finding]:
    findings: list[Finding] = []
    for line in lines:
        if has_inline_ok(line.text) or is_allowlisted(line.text, allowlist):
            continue
        for rule in RULES:
            for match in rule.pattern.finditer(line.text):
                if rule.name == "absolute user-home path" and path_match_is_allowed(match):
                    continue
                findings.append(
                    Finding(
                        source=line.source,
                        line_number=line.line_number,
                        rule=rule.name,
                        detail=rule.detail,
                        remediation=rule.remediation,
                        text=line.text,
                    )
                )
    return findings


def parse_added_diff(diff_text: str) -> list[ScannedLine]:
    lines: list[ScannedLine] = []
    current_file = "(diff)"
    new_line = 0
    for raw in diff_text.splitlines():
        if raw.startswith("+++ "):
            path = raw[4:]
            current_file = path[2:] if path.startswith("b/") else path
            continue
        if raw.startswith("@@ "):
            match = re.search(r"\+(\d+)(?:,(\d+))?", raw)
            new_line = int(match.group(1)) if match else 0
            continue
        if raw.startswith("+") and not raw.startswith("+++"):
            lines.append(ScannedLine(current_file, new_line, raw[1:]))
            new_line += 1
            continue
        if raw.startswith("-") and not raw.startswith("---"):
            continue
        if new_line:
            new_line += 1
    return lines


def metadata_lines(source: str, text: str) -> list[ScannedLine]:
    return [
        ScannedLine(source, number, line)
        for number, line in enumerate(text.splitlines(), start=1)
        if line
    ]


def staged_diff() -> str:
    return run_git(["diff", "--cached", "--unified=0", "--no-ext-diff", "--diff-filter=ACMRT"])


def rev_exists(rev: str) -> bool:
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", rev],
        cwd=REPO_ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def ci_range(explicit_range: str | None) -> str:
    if explicit_range:
        return explicit_range

    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    base_ref = os.environ.get("GITHUB_BASE_REF", "")
    before = os.environ.get("GITHUB_EVENT_BEFORE", "") or os.environ.get("GITHUB_BEFORE", "")
    sha = os.environ.get("GITHUB_SHA", "HEAD")

    if event_name == "pull_request" and base_ref:
        remote_base = f"origin/{base_ref}"
        if rev_exists(remote_base):
            return f"{remote_base}...HEAD"

    if before and not set(before) <= {"0"}:
        return f"{before}..{sha}"

    if rev_exists("HEAD^"):
        return "HEAD^..HEAD"

    return f"{NULL_TREE}..HEAD"


def diff_for_range(revision_range: str) -> str:
    return run_git(
        ["diff", "--unified=0", "--no-ext-diff", "--diff-filter=ACMRT", revision_range]
    )


def commit_messages_for_range(revision_range: str) -> str:
    return run_git(["log", "--format=%B", revision_range], check=False)


def branch_name(ci: bool) -> str:
    if ci:
        return (
            os.environ.get("GITHUB_HEAD_REF")
            or os.environ.get("GITHUB_REF_NAME")
            or os.environ.get("BRANCH_NAME")
            or ""
        )
    return run_git(["branch", "--show-current"], check=False).strip()


def print_findings(findings: list[Finding]) -> None:
    print("sanitization-scan: possible public-repo sanitization leak(s) found", file=sys.stderr)
    for finding in findings:
        print(
            f"{finding.source}:{finding.line_number}: {finding.rule}: "
            f"{finding.detail}",
            file=sys.stderr,
        )
        print(f"  line: {finding.text}", file=sys.stderr)
        print(f"  fix: {finding.remediation}", file=sys.stderr)
        print(
            "  escape hatch: if this is genuinely public-safe, add "
            "# sanitization-ok: <reason> on the same line or a generic pattern "
            "to scripts/sanitization-allow.txt.",
            file=sys.stderr,
        )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ci", action="store_true", help="Scan the CI PR/push diff and metadata.")
    parser.add_argument("--range", dest="revision_range", help="Git revision range to scan in CI mode.")
    parser.add_argument("--commit-msg-file", type=Path, help="Commit message file to scan.")
    parser.add_argument("--stdin", action="store_true", help="Scan stdin as plain content.")
    parser.add_argument("--source-name", default="stdin", help="Source label for --stdin content.")
    args = parser.parse_args(argv)

    allowlist = load_allowlist()
    lines: list[ScannedLine] = []

    if args.stdin:
        lines.extend(metadata_lines(args.source_name, sys.stdin.read()))
    elif args.ci:
        revision_range = ci_range(args.revision_range)
        lines.extend(parse_added_diff(diff_for_range(revision_range)))
        lines.extend(metadata_lines("commit messages", commit_messages_for_range(revision_range)))
    else:
        lines.extend(parse_added_diff(staged_diff()))

    current_branch = branch_name(args.ci)
    if current_branch:
        lines.append(ScannedLine("branch name", 1, current_branch))

    if args.commit_msg_file:
        lines.extend(metadata_lines(str(args.commit_msg_file), args.commit_msg_file.read_text()))

    findings = scan_lines(lines, allowlist)
    if findings:
        print_findings(findings)
        return 1

    print("sanitization-scan: passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

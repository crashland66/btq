#!/usr/bin/env python3
"""btq-validate — validate a queue job against the live queue_spec contract.

Purpose: let Cowork (a Linux sandbox that can't reach CouchDB) check a job
against the SAME `queue_spec.py` the Pro watcher enforces, *before* dropping
it into the cowork_drop bridge — so malformed jobs fail in-session in front
of Jordan instead of silently landing in failed/ on the Pro.

Runs under plain `python3` (no venv needed): `queue_spec.validate_job` only
touches `get_config()` in an unrelated vault-name helper, not the validation
path, so importing it needs only `config.py` on the path + a readable
config.json (defaulted to the repo's).

Usage:
  btq-validate < job.json
  btq-validate --file job.json

Exit code: 0 = valid, 1 = invalid, 2 = usage/import error.
Output: JSON {"valid": bool, "job_type": str|null, "reasons": [str, ...]}.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PROJECT_ROOT = REPO_ROOT / "project"
sys.path.insert(0, str(PROJECT_ROOT))
os.environ.setdefault("BT_PIPELINE_CONFIG_PATH", str(REPO_ROOT / "config.json"))

try:
    from queue_spec import (  # type: ignore
        ALLOWED_JOB_TYPES,
        ALLOWED_TOP_LEVEL_FIELDS,
        APPEND_DESTINATIONS,
        JOB_SCHEMAS,
        validate_job,
    )
except Exception as exc:  # pragma: no cover - import/environment failure
    print(json.dumps({"valid": False, "reasons": [f"cannot import queue_spec: {exc}"]}))
    raise SystemExit(2)


def diagnose(job: object) -> list[str]:
    """Best-effort human reasons for why a job fails. The authoritative
    verdict is validate_job(); this just helps the author fix it."""
    reasons: list[str] = []
    if not isinstance(job, dict):
        return ["job must be a JSON object"]
    extra = set(job) - ALLOWED_TOP_LEVEL_FIELDS
    if extra:
        reasons.append(
            f"unexpected top-level fields {sorted(extra)}; "
            f"allowed: {sorted(ALLOWED_TOP_LEVEL_FIELDS)}"
        )
    job_type = job.get("job_type")
    if not isinstance(job_type, str) or job_type not in ALLOWED_JOB_TYPES:
        reasons.append(
            f"job_type {job_type!r} is not an executable type; "
            f"see ALLOWED_JOB_TYPES in queue_spec.py"
        )
        return reasons  # nothing more checkable without a valid type
    payload = job.get("payload")
    if not isinstance(payload, dict):
        reasons.append("payload is missing or not an object")
        return reasons
    missing = [f for f in JOB_SCHEMAS[job_type] if f not in payload]
    if missing:
        reasons.append(f"missing required payload field(s) for {job_type}: {missing}")
    if job_type == "append_to_note" and payload.get("destination") not in APPEND_DESTINATIONS:
        reasons.append(
            f"destination {payload.get('destination')!r} not in {sorted(APPEND_DESTINATIONS)}"
        )
    return reasons


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--file", type=Path, help="Read job JSON from this path instead of stdin.")
    args = parser.parse_args(argv)

    raw = args.file.read_text() if args.file else sys.stdin.read()
    try:
        job = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(json.dumps({"valid": False, "reasons": [f"input is not valid JSON: {exc}"]}, indent=2))
        return 1

    valid = validate_job(job)
    if valid:
        reasons: list[str] = []
    else:
        reasons = diagnose(job) or ["does not match queue_spec (no specific reason detected)"]

    print(json.dumps(
        {
            "valid": valid,
            "job_type": job.get("job_type") if isinstance(job, dict) else None,
            "reasons": reasons,
        },
        indent=2,
    ))
    return 0 if valid else 1


if __name__ == "__main__":
    raise SystemExit(main())

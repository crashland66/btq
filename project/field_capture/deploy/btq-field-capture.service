[Unit]
Description=BTQ Field Capture Intake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=btq-field
Group=btq-field
WorkingDirectory=/srv/btq/apps/field-capture/project
Environment=PYTHONPATH=/srv/btq/apps/field-capture/project
Environment=BT_PIPELINE_CONFIG_PATH=/srv/btq/apps/field-capture/config.json
EnvironmentFile=-/etc/btq/field-capture.env
ExecStart=/usr/bin/python3 -m field_capture.server --db /srv/btq/data/field_capture_tokens.sqlite3 --vault-root /srv/btq/data/vault-readonly --upload-dir /srv/btq/runtime/uploads serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/btq/runtime /srv/btq/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

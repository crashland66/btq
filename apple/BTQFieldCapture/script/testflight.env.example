# Copy this file to script/testflight.env for App Store Connect uploads.
# Keep script/testflight.env and AuthKey_*.p8 untracked.

# Required for archive/export signing. This may match script/ios_device.env.
BTQ_DEVELOPMENT_TEAM="<team id>"

# Required only for --upload. Create an App Store Connect API key with access
# to the app, download the .p8 once, and place it outside git or as an
# untracked script/AuthKey_<key id>.p8.
BTQ_ASC_KEY_ID="<app store connect key id>"
BTQ_ASC_ISSUER_ID="<app store connect issuer id>"
BTQ_ASC_KEY_PATH="script/AuthKey_<key id>.p8"

# Optional. App Store Connect rejects duplicate build numbers. If omitted, the
# script uses a UTC timestamp build number.
# BTQ_BUILD_NUMBER="2026061401"
# BTQ_MARKETING_VERSION="1.3.2"

# Optional. Defaults to NO to avoid local Xcode/rsync symbol-packaging issues
# during the first TestFlight lane. Set to YES later if dSYM upload is needed.
# BTQ_UPLOAD_SYMBOLS="NO"

# Optional. Defaults to NO so uploaded builds can be assigned to external
# testers. Internal-only TestFlight builds cannot later be sent to external
# TestFlight or App Store review, so set this to YES only for private smoke
# builds.
BTQ_TESTFLIGHT_INTERNAL_ONLY="NO"

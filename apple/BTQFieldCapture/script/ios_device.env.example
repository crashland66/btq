# Copy this file to script/ios_device.env for local physical-iPhone checks.
# Keep script/ios_device.env untracked; it may contain personal Apple account
# and device details.

BTQ_DEVELOPMENT_TEAM="<team id>"
BTQ_DEVICE_NAME="<device name>"

# Optional when the displayed device name is ambiguous.
# BTQ_XCODE_DESTINATION="platform=iOS,name=<device name>"
# BTQ_DEVICE_SELECTOR="<device name or identifier accepted by devicectl>"
